---
import HeaderLink from './HeaderLink.astro';
import { LINKEDIN_URL } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header>
	<nav>
		<h2>
			<a href={`${base}/`}>Julia Querevalu</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>Inicio</HeaderLink>
			<HeaderLink href={`${base}/proyectos/`}>Proyectos</HeaderLink>
			<HeaderLink href={`${base}/blog/`}>Blog</HeaderLink>
			<HeaderLink href={`${base}/about/`}>Acerca de mí</HeaderLink>
		</div>
		<div class="social-links">
			<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Ver el perfil de Julia Querevalu en LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.432.568-.88 1.232-.88.869 0 1.216.662 1.216 1.634v3.867h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.5em;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0 1em;
		}
		.internal-links {
			gap: 0;
			flex-wrap: wrap;
			justify-content: center;
		}
		nav a {
			padding: 0.6em 0.4em;
		}
	}
</style>
