---
import { Image } from 'astro:assets';
import Asistente from '../components/Asistente.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT_EMAIL, LINKEDIN_URL } from '../consts';
import perfil from '../assets/perfil-about.webp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title="Acerca de mí | Julia Querevalu"
			description="Licenciada en Recursos Humanos, posgrado en RR.HH., máster en People Analytics y Gestión del Talento Digital. Docente, coach de liderazgo y consultora de RR.HH."
			image={perfil}
		/>
		<style>
			main {
				width: 920px;
				max-width: calc(100% - 2em);
				padding: 0 1em 4em;
			}
			.hero {
				display: grid;
				grid-template-columns: 300px 1fr;
				gap: 2.5em;
				align-items: center;
				padding: 4em 0 2em;
			}
			.hero-image :global(img) {
				width: 100%;
				border-radius: 20px;
				box-shadow: var(--box-shadow);
			}
			.eyebrow {
				font-size: 0.8em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
			}
			h1 {
				font-size: 2.8em;
				margin-bottom: 0.3em;
			}
			.lead {
				font-size: 1.15em;
			}
			.facts {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 1.25em;
				list-style: none;
				padding: 0;
			}
			.facts li {
				padding: 0.3em 0.9em;
				border-radius: 999px;
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				font-size: 0.8em;
				font-weight: 700;
			}
			section {
				padding: 2em 0;
				border-top: 1px solid rgb(var(--gray-light));
				scroll-margin-top: 2em;
			}
			h2 {
				font-size: 1.8em;
			}
			.grid-2 {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
			}
			.item {
				padding: 1.25em 1.5em;
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
			}
			.item h3 {
				font-size: 1.15em;
				margin-bottom: 0.2em;
			}
			.item .meta {
				font-size: 0.8em;
				color: var(--accent);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.item p {
				margin: 0.5em 0 0;
				font-size: 0.95em;
			}
			.contact {
				padding: 2em;
				border-radius: 20px;
				background: rgb(var(--black));
				color: #fff;
			}
			.contact h2 {
				color: #fff;
			}
			.contact p {
				color: rgba(255, 255, 255, 0.85);
			}
			.contact a {
				color: #fff;
				font-weight: 700;
			}
			.buttons {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
				margin-top: 1.25em;
			}
			.buttons a {
				display: inline-block;
				padding: 0.6em 1.2em;
				border-radius: 999px;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
				font-size: 0.9em;
			}
			.buttons a:hover {
				background: var(--accent-dark);
			}
			@media (max-width: 760px) {
				.hero,
				.grid-2 {
					grid-template-columns: 1fr;
				}
				.hero-image {
					max-width: 300px;
				}
				h1 {
					font-size: 2.2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div class="hero-image">
					<Image src={perfil} width={600} alt="Retrato ilustrado de Julia Querevalu" />
				</div>
				<div>
					<span class="eyebrow">Perfil profesional</span>
					<h1>Julia Querevalu</h1>
					<p class="lead">
						Licenciada en Recursos Humanos, con posgrado en Recursos Humanos y máster en
						People Analytics y Gestión del Talento Digital. Docente de HR Analytics en la
						Universidad San Martín, coach de liderazgo y consultora de RR.HH.
					</p>
					<ul class="facts">
						<li>📊 People Analytics</li>
						<li>🎓 Docencia universitaria</li>
						<li>🧭 Coaching de liderazgo</li>
						<li>🤝 Consultoría de RR.HH.</li>
					</ul>
				</div>
			</div>

			<section id="formacion">
				<h2>Formación</h2>
				<div class="grid-2">
					<div class="item">
						<span class="meta">Grado</span>
						<h3>Licenciatura en Recursos Humanos</h3>
						<p>Base sólida en gestión de personas, relaciones laborales y desarrollo organizacional.</p>
					</div>
					<div class="item">
						<span class="meta">Posgrado</span>
						<h3>Posgrado en Recursos Humanos</h3>
						<p>Especialización en estrategia de talento, diseño de procesos y liderazgo.</p>
					</div>
					<div class="item">
						<span class="meta">Máster</span>
						<h3>People Analytics y Gestión del Talento Digital</h3>
						<p>Análisis de datos de personas, métricas de talento y transformación digital de RR.HH.</p>
					</div>
					<div class="item">
						<span class="meta">Desarrollo profesional</span>
						<h3>Coaching de liderazgo</h3>
						<p>Formación y práctica en acompañamiento a líderes y equipos de alto desempeño.</p>
					</div>
				</div>
			</section>

			<section id="docencia">
				<h2>Docencia</h2>
				<p>
					Soy docente de <strong>HR Analytics</strong> en la <strong>Universidad San Martín</strong>,
					donde acompaño a estudiantes y profesionales en el uso de datos para comprender el
					comportamiento de las personas en las organizaciones. Me interesa que cada clase
					conecte la teoría con problemas reales: rotación, clima, sucesión, engagement y
					desarrollo de talento.
				</p>
				<p>
					En el aula combino casos prácticos, herramientas de visualización y discusión ética
					sobre el uso de la información, porque analizar personas siempre implica mirar
					también el contexto y las decisiones que se toman a partir de los datos.
				</p>
			</section>

			<section id="coaching">
				<h2>Coaching y consultoría</h2>
				<div class="grid-2">
					<div class="item">
						<span class="meta">Coaching</span>
						<h3>Coaching de liderazgo</h3>
						<p>
							Acompaño a líderes y mandos medios a ganar claridad en su rol, fortalecer su
							comunicación y construir equipos más comprometidos. Procesos individuales y
							grupales, siempre confidenciales y adaptados a cada momento.
						</p>
					</div>
					<div class="item">
						<span class="meta">Consultoría</span>
						<h3>Consultoría de RR.HH.</h3>
						<p>
							Diseño diagnósticos de clima, modelos de competencias, planes de sucesión y
							rutas de formación. Trabajo con datos, pero sobre todo con las personas que
							deben poner cada cambio en marcha.
						</p>
					</div>
				</div>
			</section>

			<section id="contacto">
				<div class="contact">
					<h2>Contacto</h2>
					<p>
						¿Quieres conversar sobre un proyecto de People Analytics, formación para tu
						equipo o un proceso de liderazgo? Estaré encantada de escucharte.
					</p>
					<p>
						Correo: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
						LinkedIn: <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">Ver perfil</a>
					</p>
					<div class="buttons">
						<a href={`mailto:${CONTACT_EMAIL}`}>Escríbeme</a>
						<a href={`${base}/proyectos/`}>Ver proyectos</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
		<Asistente />
	</body>
</html>
