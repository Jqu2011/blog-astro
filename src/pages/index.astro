---
import { Image } from 'astro:assets';
import Asistente from '../components/Asistente.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { proyectos } from '../data/proyectos';
import perfil from '../assets/perfil-about.webp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={perfil} />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2em);
				padding: 0 1em 4em;
			}
			.hero {
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 3em;
				align-items: center;
				padding: 4em 0 3em;
			}
			.eyebrow {
				display: inline-block;
				font-size: 0.8em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.75em;
			}
			h1 {
				font-size: 3.4em;
				margin-bottom: 0.4em;
			}
			h1 span {
				color: var(--accent);
			}
			.lead {
				font-size: 1.2em;
				color: rgb(var(--gray-dark));
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
				margin-top: 1.75em;
			}
			.button {
				display: inline-block;
				padding: 0.7em 1.4em;
				border-radius: 999px;
				background: var(--accent);
				color: #fff;
				font-weight: 700;
				text-decoration: none;
				font-size: 0.9em;
			}
			.button.secondary {
				background: transparent;
				color: var(--accent);
				border: 2px solid var(--accent);
			}
			.button:hover {
				background: var(--accent-dark);
				color: #fff;
			}
			.button.secondary:hover {
				background: var(--accent);
				color: #fff;
			}
			.hero-image :global(img) {
				width: 100%;
				border-radius: 24px;
				box-shadow: var(--box-shadow);
			}
			section {
				padding: 2.5em 0;
				border-top: 1px solid rgb(var(--gray-light));
			}
			h2 {
				font-size: 2em;
				margin-bottom: 0.2em;
			}
			.section-intro {
				color: rgb(var(--gray));
				max-width: 640px;
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25em;
				margin-top: 2em;
			}
			.card {
				display: block;
				padding: 1.5em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				background: #fff;
				text-decoration: none;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.card:hover {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow);
			}
			.card .icon {
				font-size: 1.8em;
			}
			.card h3 {
				font-size: 1.2em;
				margin: 0.5em 0 0.3em;
			}
			.card p {
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
				margin: 0;
			}
			.projects {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
				margin-top: 2em;
			}
			.project {
				display: grid;
				grid-template-columns: 180px 1fr;
				gap: 1.2em;
				align-items: center;
				padding: 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				background: #fff;
				text-decoration: none;
				color: inherit;
			}
			.project:hover {
				box-shadow: var(--box-shadow);
			}
			.project :global(img) {
				width: 100%;
				border-radius: 12px;
			}
			.project h3 {
				font-size: 1.1em;
				margin-bottom: 0.3em;
			}
			.project p {
				font-size: 0.85em;
				color: rgb(var(--gray-dark));
				margin: 0;
			}
			.cta {
				margin-top: 2em;
				padding: 2em;
				border-radius: 20px;
				background: rgb(var(--black));
				color: #fff;
				text-align: center;
			}
			.cta h2 {
				color: #fff;
			}
			.cta p {
				color: rgba(255, 255, 255, 0.8);
			}
			@media (max-width: 860px) {
				.hero,
				.cards,
				.projects {
					grid-template-columns: 1fr;
				}
				h1 {
					font-size: 2.6em;
				}
				.hero-image {
					max-width: 480px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div>
					<span class="eyebrow">RR.HH. · People Analytics · Liderazgo</span>
					<h1>Hola, soy <span>Julia Querevalu</span></h1>
					<p class="lead">
						Convierto los datos de personas en decisiones más humanas. Combino el análisis,
						la docencia y el coaching para ayudar a líderes y equipos a crecer con criterio,
						claridad y propósito.
					</p>
					<div class="actions">
						<a class="button" href={`${base}/proyectos/`}>Ver mis proyectos</a>
						<a class="button secondary" href={`${base}/about/`}>Conóceme más</a>
					</div>
				</div>
				<div class="hero-image">
					<Image src={perfil} width={900} priority alt="Retrato ilustrado de Julia Querevalu" />
				</div>
			</div>

			<section id="que-hago">
				<h2>Qué hago</h2>
				<p class="section-intro">
					Tres maneras de acompañar a las organizaciones, siempre con el mismo enfoque:
					evidencia para entender, conversación para transformar.
				</p>
				<div class="cards">
					<a class="card" href={`${base}/about/#formacion`}>
						<div class="icon" aria-hidden="true">📊</div>
						<h3>People Analytics</h3>
						<p>
							Diagnóstico de talento, clima y rotación para decidir con datos, no con
							suposiciones.
						</p>
					</a>
					<a class="card" href={`${base}/about/#docencia`}>
						<div class="icon" aria-hidden="true">🎓</div>
						<h3>Docencia</h3>
						<p>
							Formo a futuros profesionales y líderes en HR Analytics desde la Universidad
							San Martín.
						</p>
					</a>
					<a class="card" href={`${base}/about/#coaching`}>
						<div class="icon" aria-hidden="true">🧭</div>
						<h3>Coaching y consultoría</h3>
						<p>
							Acompaño procesos de liderazgo y diseño soluciones de RR.HH. a medida de cada
							equipo.
						</p>
					</a>
				</div>
			</section>

			<section>
				<h2>Proyectos destacados</h2>
				<p class="section-intro">
					Una selección de iniciativas donde la analítica y la estrategia de personas van de
					la mano.
				</p>
				<div class="projects">
					{
						proyectos.slice(0, 2).map((proyecto) => (
							<a
								class="project"
								href={`${base}/proyectos/#${proyecto.titulo
									.toLowerCase()
									.normalize('NFD')
									.replace(/\p{Diacritic}/gu, '')
									.replaceAll(' ', '-')}`}
							>
								<Image
									src={proyecto.imagen}
									width={360}
									alt={`Ilustración del proyecto ${proyecto.titulo}`}
								/>
								<div>
									<h3>{proyecto.titulo}</h3>
									<p>{proyecto.resumen}</p>
								</div>
							</a>
						))
					}
				</div>
				<div class="actions">
					<a class="button secondary" href={`${base}/proyectos/`}>Ver todos los proyectos</a>
				</div>
			</section>

			<section>
				<div class="cta">
					<h2>¿Trabajamos juntos?</h2>
					<p>Si tienes un reto de personas, talento o liderazgo, hablemos.</p>
					<div class="actions" style="justify-content:center">
						<a class="button" href={`${base}/about/#contacto`}>Escríbeme</a>
						<a class="button secondary" href={`${base}/blog/`}>Leer el blog</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
		<Asistente />
	</body>
</html>
