---
import { Image } from 'astro:assets';
import Asistente from '../components/Asistente.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { proyectos } from '../data/proyectos';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const slug = (texto: string) =>
	texto
		.toLowerCase()
		.normalize('NFD')
		.replace(/\p{Diacritic}/gu, '')
		.replaceAll(' ', '-');
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title="Proyectos | Julia Querevalu"
			description="Proyectos de People Analytics, formación, coaching de liderazgo y transformación digital de RR.HH."
			image={proyectos[0].imagen}
		/>
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				padding: 0 1em 4em;
			}
			.intro {
				padding: 4em 0 2em;
				max-width: 760px;
			}
			.eyebrow {
				font-size: 0.8em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
			}
			h1 {
				font-size: 3em;
			}
			.proyecto {
				display: grid;
				grid-template-columns: 380px 1fr;
				gap: 2em;
				padding: 2.5em 0;
				border-top: 1px solid rgb(var(--gray-light));
				scroll-margin-top: 2em;
			}
			.proyecto:nth-child(even) .image {
				order: 2;
			}
			.image :global(img) {
				width: 100%;
				border-radius: 18px;
				box-shadow: var(--box-shadow);
			}
			.meta {
				font-size: 0.8em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--accent);
			}
			h2 {
				font-size: 1.9em;
				margin: 0.3em 0 0.4em;
			}
			.resumen {
				font-size: 1.05em;
				color: rgb(var(--gray-dark));
			}
			.detail {
				margin: 0.9em 0 0;
			}
			.detail strong {
				display: block;
				font-size: 0.8em;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: rgb(var(--gray));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				list-style: none;
				padding: 0;
				margin: 1.2em 0 0;
			}
			.tags li {
				font-size: 0.75em;
				font-weight: 700;
				padding: 0.25em 0.75em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.cta {
				margin-top: 2em;
				padding: 2em;
				border-radius: 20px;
				background: rgb(var(--black));
				color: #fff;
				text-align: center;
			}
			.cta h2 {
				color: #fff;
			}
			.cta p {
				color: rgba(255, 255, 255, 0.85);
			}
			.cta a {
				display: inline-block;
				margin-top: 0.5em;
				padding: 0.6em 1.2em;
				border-radius: 999px;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
				font-weight: 700;
				font-size: 0.9em;
			}
			@media (max-width: 820px) {
				.proyecto {
					grid-template-columns: 1fr;
					gap: 1em;
				}
				.proyecto:nth-child(even) .image {
					order: 0;
				}
				.image {
					max-width: 480px;
				}
				h1 {
					font-size: 2.4em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<span class="eyebrow">Portafolio</span>
				<h1>Proyectos</h1>
				<p>
					Ideas que nacen de preguntas reales: ¿cómo sabemos qué talento tenemos?, ¿cómo
					formamos líderes que sepan leer un dashboard y, a la vez, mirar a su equipo? Estos
					proyectos muestran mi forma de trabajar: analizar, conversar y convertir hallazgos
					en acciones concretas.
				</p>
				<p style="font-size:0.85em; color:rgb(var(--gray));">
					Los proyectos son ejemplos ilustrativos creados para este portafolio. Sustitúyelos
					por tus casos reales cuando quieras.
				</p>
			</div>

			{
				proyectos.map((proyecto) => (
					<article class="proyecto" id={slug(proyecto.titulo)}>
						<div class="image">
							<Image
								src={proyecto.imagen}
								width={760}
								alt={`Ilustración del proyecto ${proyecto.titulo}`}
							/>
						</div>
						<div>
							<span class="meta">{proyecto.categoria} · {proyecto.anio}</span>
							<h2>{proyecto.titulo}</h2>
							<p class="resumen">{proyecto.resumen}</p>
							<p class="detail"><strong>El reto</strong>{proyecto.reto}</p>
							<p class="detail"><strong>La solución</strong>{proyecto.solucion}</p>
							<p class="detail"><strong>El resultado</strong>{proyecto.resultado}</p>
							<ul class="tags">
								{proyecto.etiquetas.map((etiqueta) => <li>{etiqueta}</li>)}
							</ul>
						</div>
					</article>
				))
			}

			<div class="cta">
				<h2>¿Tienes un reto parecido?</h2>
				<p>Puedo ayudarte a convertirlo en un proyecto con resultados medibles.</p>
				<a href={`${base}/about/#contacto`}>Hablemos</a>
			</div>
		</main>
		<Footer />
		<Asistente />
	</body>
</html>
